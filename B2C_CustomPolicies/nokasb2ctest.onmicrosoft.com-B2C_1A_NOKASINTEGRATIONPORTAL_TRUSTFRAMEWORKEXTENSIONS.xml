<TrustFrameworkPolicy xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://schemas.microsoft.com/online/cpim/schemas/2013/06" PolicySchemaVersion="0.3.0.0" TenantId="nokasb2ctest.onmicrosoft.com" PolicyId="B2C_1A_NokasIntegrationPortal_TrustFrameworkExtensions" DeploymentMode="Development" UserJourneyRecorderEndpoint="urn:journeyrecorder:applicationinsights" PublicPolicyUri="http://nokasb2ctest.onmicrosoft.com/B2C_1A_NokasIntegrationPortal_TrustFrameworkExtensions" TenantObjectId="24aa7821-e848-457d-99f0-3b40c5519ad6">
