{
  "info": {
    "_postman_id": "b3f2a6d1-9e4c-4a2b-8f3d-2c7e5a1b6d90",
    "name": "NOKAS Bag Registration & Counting Result API",
    "description": "Register cash bags and retrieve counting results. Fill in your own `clientId`, `clientSecret`, and `customerRefNumber` (given to you during onboarding) under this collection's Variables tab, then run Auth -> TokenRequest once - it saves your access token into the `accessToken` variable, and every other request inherits a collection-level Bearer Token auth pointed at that variable, so nothing needs copy-pasting. Re-run TokenRequest whenever the token expires (~1 hour) or a role changes. The 'Unauthenticated' examples in each folder deliberately override auth with No Auth, to show what a missing/invalid token looks like - leave those alone.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api-test.nokas.com/api/cash-mgmt", "description": "Test environment base URL. For production, use https://api.nokas.com/api/cash-mgmt with a production client id/secret." },
    { "key": "clientId", "value": "", "description": "Your OAuth2 client id, issued during onboarding." },
    { "key": "clientSecret", "value": "", "type": "secret", "description": "Your OAuth2 client secret, issued during onboarding. Postman masks variables marked as secret." },
    { "key": "customerRefNumber", "value": "", "description": "Your customer reference number (e.g. your GLN), issued during onboarding." },
    { "key": "accessToken", "value": "", "description": "Auto-filled by Auth -> TokenRequest. Every other request's Bearer auth reads from this." },
    { "key": "lastCreatedBagNumber", "value": "", "description": "Auto-filled by 'POST - Create Bag' - later requests in the Bag Registration folder reuse it." },
    { "key": "continuationToken", "value": "", "description": "Auto-filled by the first counting-result pagination request." },
    { "key": "exampleBagNumber", "value": "", "description": "Set this to a bag number you've registered and that has since been counted, to try the single-bag counting-result lookup." },
    { "key": "fromDate", "value": "", "description": "ISO-8601 UTC date, e.g. 2026-01-01T00:00:00Z. Must be within 92 days of toDate. Set this to a window you know you have data in." }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "TokenRequest",
          "protocolProfileBehavior": { "disableBodyPruning": true },
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" },
                { "key": "client_id", "value": "{{clientId}}", "type": "text" },
                { "key": "client_secret", "value": "{{clientSecret}}", "type": "text" },
                { "key": "scope", "value": "https://nokasb2ctest.onmicrosoft.com/api/nokas/.default", "type": "text" }
              ]
            },
            "url": {
              "raw": "https://api-test.nokas.com/oauth2/v2.0/token",
              "protocol": "https",
              "host": ["api-test", "nokas", "com"],
              "path": ["oauth2", "v2.0", "token"]
            },
            "description": "Run this first (and whenever the token expires or a role changes) - saves the access token into {{accessToken}}, which every other request's collection-level Bearer auth reads from automatically."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.access_token);",
                  "console.log('accessToken updated, expires_in=' + body.expires_in + 's');"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Bag Registration",
      "item": [
        {
          "name": "POST - Create Bag (201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "X-Correlation-ID", "value": "{{$guid}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"bagRegistration\": {\n        \"customerRefNumber\": \"{{customerRefNumber}}\",\n        \"registrationType\": \"NOK\",\n        \"messageId\": \"{{$guid}}\",\n        \"bagNumber\": \"9{{$timestamp}}\",\n        \"registrationDate\": \"{{$isoTimestamp}}\",\n        \"referenceStatement\": \"postman-example\",\n        \"turnOverDate\": \"{{$isoTimestamp}}\",\n        \"registeredNotes\": \"1000\",\n        \"registeredCoins\": \"0\",\n        \"registeredChecks\": \"0\",\n        \"totalOrderAmount\": \"10000\",\n        \"bagItemsLC\": {\n            \"seddel1000\": \"1000\",\n            \"seddel500\": \"0\",\n            \"seddel200\": \"0\",\n            \"seddel100\": \"0\",\n            \"seddel50\": \"0\"\n        }\n    }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/bag-registration",
              "host": ["{{baseUrl}}"],
              "path": ["bag-registration"]
            },
            "description": "Bag number is generated from the current timestamp, so this is safe to re-run - bag numbers can never be reused via this API. On success, saves the bag number into {{lastCreatedBagNumber}} for the requests below."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('lastCreatedBagNumber', body.bagNumber);",
                  "    pm.test('Response has bagLifecycleId', () => pm.expect(body.bagLifecycleId).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "POST - Duplicate Bag (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "X-Correlation-ID", "value": "{{$guid}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"bagRegistration\": {\n        \"customerRefNumber\": \"{{customerRefNumber}}\",\n        \"registrationType\": \"NOK\",\n        \"messageId\": \"{{$guid}}\",\n        \"bagNumber\": \"{{lastCreatedBagNumber}}\",\n        \"registrationDate\": \"{{$isoTimestamp}}\",\n        \"referenceStatement\": \"postman-example\",\n        \"turnOverDate\": \"{{$isoTimestamp}}\",\n        \"registeredNotes\": \"1000\",\n        \"registeredCoins\": \"0\",\n        \"registeredChecks\": \"0\",\n        \"totalOrderAmount\": \"10000\",\n        \"bagItemsLC\": {\n            \"seddel1000\": \"1000\",\n            \"seddel500\": \"0\",\n            \"seddel200\": \"0\",\n            \"seddel100\": \"0\",\n            \"seddel50\": \"0\"\n        }\n    }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/bag-registration",
              "host": ["{{baseUrl}}"],
              "path": ["bag-registration"]
            },
            "description": "Run right after 'POST - Create Bag' - reuses {{lastCreatedBagNumber}}. Expect ERR_DUPLICATE_BAG - bag numbers can never be reused, even after cancellation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Code is ERR_DUPLICATE_BAG', () => pm.expect(pm.response.json().code).to.eql('ERR_DUPLICATE_BAG'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "GET - Bag Found (200)",
          "protocolProfileBehavior": { "disableBodyPruning": true },
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "X-Correlation-ID", "value": "{{$guid}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bag-registration/{{lastCreatedBagNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["bag-registration", "{{lastCreatedBagNumber}}"]
            }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }
          ],
          "response": []
        },
        {
          "name": "GET - Bag Not Found (404)",
          "protocolProfileBehavior": { "disableBodyPruning": true },
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "X-Correlation-ID", "value": "{{$guid}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bag-registration/999999999999",
              "host": ["{{baseUrl}}"],
              "path": ["bag-registration", "999999999999"]
            },
            "description": "A bag number that was never registered for your client."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 404', () => pm.response.to.have.status(404));"] } }
          ],
          "response": []
        },
        {
          "name": "GET - Unauthenticated (401)",
          "protocolProfileBehavior": { "disableBodyPruning": true },
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "X-Correlation-ID", "value": "{{$guid}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bag-registration/{{lastCreatedBagNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["bag-registration", "{{lastCreatedBagNumber}}"]
            },
            "description": "Deliberately overrides the collection auth with No Auth, to show what a missing token looks like."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"] } }
          ],
          "response": []
        },
        {
          "name": "DELETE - Cancel Bag (200)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "X-Correlation-ID", "value": "{{$guid}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bag-registration/{{lastCreatedBagNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["bag-registration", "{{lastCreatedBagNumber}}"]
            },
            "description": "No request body needed - only the bagNumber in the path matters."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }
          ],
          "response": []
        },
        {
          "name": "DELETE - Already Cancelled (409)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "X-Correlation-ID", "value": "{{$guid}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bag-registration/{{lastCreatedBagNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["bag-registration", "{{lastCreatedBagNumber}}"]
            },
            "description": "Run right after 'DELETE - Cancel Bag'. Expect ERR_ALREADY_CANCELLED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Code is ERR_ALREADY_CANCELLED', () => pm.expect(pm.response.json().code).to.eql('ERR_ALREADY_CANCELLED'));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "DELETE - Bag Not Found (404)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "X-Correlation-ID", "value": "{{$guid}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bag-registration/999999999998",
              "host": ["{{baseUrl}}"],
              "path": ["bag-registration", "999999999998"]
            }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 404', () => pm.response.to.have.status(404));"] } }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Counting Result - List",
      "item": [
        {
          "name": "List - dateType=registered",
          "protocolProfileBehavior": { "disableBodyPruning": true },
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/bag-counting-results?fromDate={{fromDate}}&toDate={{$isoTimestamp}}&dateType=registered&customerRefNumber={{customerRefNumber}}&pageSize=100",
              "host": ["{{baseUrl}}"],
              "path": ["bag-counting-results"],
              "query": [
                { "key": "fromDate", "value": "{{fromDate}}" },
                { "key": "toDate", "value": "{{$isoTimestamp}}" },
                { "key": "dateType", "value": "registered" },
                { "key": "customerRefNumber", "value": "{{customerRefNumber}}" },
                { "key": "pageSize", "value": "100" }
              ]
            },
            "description": "dateType=registered is the most inclusive filter - shows bags regardless of counted status. Set the {{fromDate}} collection variable to a window you know you have data in (must be within 92 days of now)."
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }
          ],
          "response": []
        },
        {
          "name": "List - dateType=counted",
          "protocolProfileBehavior": { "disableBodyPruning": true },
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/bag-counting-results?fromDate={{fromDate}}&toDate={{$isoTimestamp}}&dateType=counted&customerRefNumber={{customerRefNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["bag-counting-results"],
              "query": [
                { "key": "fromDate", "value": "{{fromDate}}" },
                { "key": "toDate", "value": "{{$isoTimestamp}}" },
                { "key": "dateType", "value": "counted" },
                { "key": "customerRefNumber", "value": "{{customerRefNumber}}" }
              ]
            },
            "description": "Implies countedAt != null - only bags that have actually been counted show up, even if their registeredAt is in range. This is the default dateType if you omit the parameter."
          },
          "response": []
        },
        {
          "name": "List - status=registered",
          "protocolProfileBehavior": { "disableBodyPruning": true },
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/bag-counting-results?fromDate={{fromDate}}&toDate={{$isoTimestamp}}&dateType=registered&status=registered&customerRefNumber={{customerRefNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["bag-counting-results"],
              "query": [
                { "key": "fromDate", "value": "{{fromDate}}" },
                { "key": "toDate", "value": "{{$isoTimestamp}}" },
                { "key": "dateType", "value": "registered" },
                { "key": "status", "value": "registered" },
                { "key": "customerRefNumber", "value": "{{customerRefNumber}}" }
              ]
            }
          },
          "response": []
        },
