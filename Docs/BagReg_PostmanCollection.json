          "protocolProfileBehavior": { "disableBodyPruning": true },
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/bag-counting-results?fromDate={{fromDate}}&toDate={{$isoTimestamp}}&dateType=registered&status=in-progress&customerRefNumber={{customerRefNumber}}",
              "host": ["{{baseUrl}}"],
