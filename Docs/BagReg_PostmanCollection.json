        {
          "name": "List - customerRefNumber not yours (empty, not 403)",
          "protocolProfileBehavior": { "disableBodyPruning": true },
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/bag-counting-results?fromDate={{fromDate}}&toDate={{$isoTimestamp}}&dateType=registered&customerRefNumber=0000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["bag-counting-results"],
              "query": [
                { "key": "fromDate", "value": "{{fromDate}}" },
                { "key": "toDate", "value": "{{$isoTimestamp}}" },
                { "key": "dateType", "value": "registered" },
                { "key": "customerRefNumber", "value": "0000000000000" }
              ]
            },
            "description": "A customerRefNumber you're not associated with returns 200 with an empty list - never a 403 or an error."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Items is empty', () => pm.expect(pm.response.json().items).to.have.lengthOf(0));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List - Page 1 (pageSize=10)",
          "protocolProfileBehavior": { "disableBodyPruning": true },
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/bag-counting-results?fromDate={{fromDate}}&toDate={{$isoTimestamp}}&dateType=registered&customerRefNumber={{customerRefNumber}}&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["bag-counting-results"],
              "query": [
                { "key": "fromDate", "value": "{{fromDate}}" },
                { "key": "toDate", "value": "{{$isoTimestamp}}" },
                { "key": "dateType", "value": "registered" },
                { "key": "customerRefNumber", "value": "{{customerRefNumber}}" },
                { "key": "pageSize", "value": "10" }
              ]
            },
            "description": "You'll need more than 10 bags registered in your chosen date window for hasMore to come back true. Saves the continuation token into {{continuationToken}} for the next request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.pagination && body.pagination.continuationToken) {",
                  "    pm.collectionVariables.set('continuationToken', body.pagination.continuationToken);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List - Page 2 (continuationToken)",
          "protocolProfileBehavior": { "disableBodyPruning": true },
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{baseUrl}}/bag-counting-results?fromDate={{fromDate}}&toDate={{$isoTimestamp}}&dateType=registered&customerRefNumber={{customerRefNumber}}&pageSize=10&continuationToken={{continuationToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["bag-counting-results"],
              "query": [
