    {
      "name": "2. Counting Results (GET counting_results)",
      "item": [
        {
          "name": "2.1 Changed in the last 15 minutes (what the sync does)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{snBaseUrl}}/counting_results/dk?startDate={{windowFrom}}&endDate={{windowTo}}",
              "host": [
                "{{snBaseUrl}}"
              ],
              "path": [
                "counting_results",
                "dk"
              ],
              "query": [
                {
                  "key": "startDate",
                  "value": "{{windowFrom}}"
                },
                {
                  "key": "endDate",
                  "value": "{{windowTo}}"
                }
              ]
            },
            "description": "startDate/endDate filter on LAST-MODIFIED time (changed 2026-09-25) and are given in ServiceNow's local time as 'yyyy-MM-dd HH:mm:ss'. This is exactly what the sync Function does every 10 minutes: ask for what changed since last time. The pre-request script builds the window in Copenhagen time - sending UTC would quietly return nothing."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ServiceNow speaks Central European time (CET/CEST), not UTC - build the window in theirs.",
                  "const fmt = d => new Date(d).toLocaleString('sv-SE', { timeZone: 'Europe/Copenhagen' }).replace('T', ' ').slice(0, 19);",
                  "pm.collectionVariables.set('windowTo', fmt(Date.now()));",
                  "pm.collectionVariables.set('windowFrom', fmt(Date.now() - 15 * 60 * 1000));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const rows = (j.result && j.result.result) || [];",
                  "pm.test('has result.result array', () => pm.expect(rows).to.be.an('array'));",
                  "console.log('rows:', rows.length);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 A wide window (everything we would backfill)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
