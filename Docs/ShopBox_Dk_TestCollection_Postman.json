      "name": "0. Auth",
      "item": [
        {
          "name": "Get token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "https://login.microsoftonline.com/{{tenantId}}/oauth2/v2.0/token",
              "host": [
                "login",
                "microsoftonline",
                "com"
              ],
              "path": [
                "{{tenantId}}",
                "oauth2",
                "v2.0",
                "token"
              ]
            },
            "description": "Run this first. Roles are fixed when a token is issued, so after any role change, get a new token.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}"
                },
                {
                  "key": "scope",
                  "value": "https://nokasb2ctest.onmicrosoft.com/api/nokas/.default"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.test('Token issued', () => pm.expect(j.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('accessToken', j.access_token);",
                  "const roles = JSON.parse(atob(j.access_token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))).roles || [];",
                  "console.log('Roles in token:', roles.join(', '));",
                  "pm.test('Has DK registration role', () => pm.expect(roles).to.include('cashbag.dk.registration.access'));",
                  "pm.test('Has DK counting-result role', () => pm.expect(roles).to.include('cashbag.dk.countingresult.read'));"
                ]
              }
            }
          ]
        }
      ]
