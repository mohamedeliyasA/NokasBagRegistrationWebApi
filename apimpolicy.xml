<!--
    - Policies are applied in the order they appear.
    - Position <base/> inside a section to inherit policies from the outer scope.
    - Comments within policies are not preserved.
-->
<!-- Add policies as children to the <inbound>, <outbound>, <backend>, and <on-error> elements -->
<policies>
    <!-- Throttle, authorize, validate, cache, or transform the requests -->
    <inbound>
        <base />
        <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="Unauthorized" output-token-variable-name="jwtToken">
            <openid-config url="https://login.microsoftonline.com/24aa7821-e848-457d-99f0-3b40c5519ad6/v2.0/.well-known/openid-configuration" />
            <audiences>
                <audience>https://nokasb2ctest.onmicrosoft.com/api/nokas</audience>
            </audiences>
            <issuers>
                <issuer>https://sts.windows.net/24aa7821-e848-457d-99f0-3b40c5519ad6/</issuer>
            </issuers>
        </validate-jwt>
        <set-variable name="rateLimitKey" value="@{
  var jwt = context.Variables.GetValueOrDefault("jwtToken") as Jwt;
  var appId = jwt?.Claims.GetValueOrDefault("appid","unknown-app");
  var iss   = jwt?.Claims.GetValueOrDefault("iss","unknown-iss");
  return iss + "|" + appId;
}" />
        <rate-limit-by-key calls="100" renewal-period="60" counter-key="@((string)context.Variables["rateLimitKey"])" />
        <set-backend-service base-url="https://api-nokas-bagreg-v2.azurewebsites.net/" />
    </inbound>
    <!-- Control if and how the requests are forwarded to services  -->
    <backend>
        <base />
    </backend>
    <!-- Customize the responses -->
    <outbound>
        <base />
    </outbound>
    <!-- Handle exceptions and customize error responses  -->
    <on-error>
        <base />
    </on-error>
</policies>